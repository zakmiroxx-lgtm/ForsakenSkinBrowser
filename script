local notificationId = 0

local function notify(message, color)

    notificationId += 1

    local currentId = notificationId

    Notification.Text = tostring(message)
    Notification.TextColor3 = color or CONFIG.Text

    task.delay(4, function()

        if currentId == notificationId
            and Notification.Parent then

            Notification.Text = "Ready"
            Notification.TextColor3 = CONFIG.MutedText

        end

    end)

end

--// DATA STORAGE

local FoundSkins = {}

--// SCAN ALL SKINS

local function scanSkins()

    table.clear(FoundSkins)

    if not SkinsFolder then
        notify("Skin not found: Assets.Skins", CONFIG.Error)
        return
    end

    local success, err = pcall(function()

        -- Expected structure:
        --
        -- Assets
        --   Skins
        --     Survivors
        --       Shedletsky
        --         ModernShedletsky
        --
        --     Killers
        --       Character
        --         Skin
        --
        -- Additional categories are supported.

        for _, category in ipairs(SkinsFolder:GetChildren()) do

            for _, character in ipairs(category:GetChildren()) do

                for _, skin in ipairs(character:GetChildren()) do

                    table.insert(FoundSkins, {
                        Name = skin.Name,
                        Character = character.Name,
                        Category = category.Name,
                        Instance = skin
                    })

                end

            end

        end

    end)

    if not success then

        warn("[Skin Scanner] " .. tostring(err))
        notify("Skin scan failed", CONFIG.Error)

        return

    end

    table.sort(FoundSkins, function(a, b)

        if a.Category ~= b.Category then
            return a.Category < b.Category
        end

        if a.Character ~= b.Character then
            return a.Character < b.Character
        end

        return a.Name < b.Name

    end)

    Counter.Text = "Skins found: " .. tostring(#FoundSkins)

end

--// VALIDATE SERVER RESPONSE

local function isPurchaseConfirmed(result)

    -- Only explicit positive responses count as confirmation.
    -- The actual response format depends on the game server.

    if result == true then
        return true
    end

    if type(result) == "table" then

        if result.Success == true then
            return true
        end

        if result.success == true then
            return true
        end

        if result.Purchased == true then
            return true
        end

        if result.purchased == true then
            return true
        end

    end

    return false

end

--// PURCHASE FUNCTION

local PurchaseInProgress = false

local function purchaseSkin(selectedSkin)

    if PurchaseInProgress then
        notify("Purchase already in progress", CONFIG.Error)
        return
    end

    if not selectedSkin then
        notify("Skin not found", CONFIG.Error)
        return
    end

    if not selectedSkin:IsDescendantOf(SkinsFolder) then
        notify("Skin not found", CONFIG.Error)
        return
    end

    if not PurchaseRemote then
        notify("Purchase failed: RemoteFunction missing", CONFIG.Error)
        return
    end

    PurchaseInProgress = true

    notify("Purchasing " .. selectedSkin.Name .. "...", CONFIG.Accent)

    task.spawn(function()

        local args = {
            [1] = "PurchaseContent",

            [2] = {
                [1] = selectedSkin,
                [2] = nil
            }
        }

        local success, result = pcall(function()

            return PurchaseRemote:InvokeServer(
                unpack(args)
            )

        end)

        PurchaseInProgress = false

        if not success then

            warn(
                "[Purchase Error] "
                .. tostring(result)
            )

            notify("Purchase failed", CONFIG.Error)

            return

        end

        if isPurchaseConfirmed(result) then

            notify("Skin purchased", CONFIG.Success)

        else

            -- The server returned no recognizable confirmation.
            -- Do not claim that the purchase succeeded.

            warn(
                "[Purchase] Unconfirmed server response:",
                result
            )

            notify(
                "Purchase failed or not confirmed",
                CONFIG.Error
            )

        end

    end)

end

