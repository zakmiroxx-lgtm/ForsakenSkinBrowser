--// RENDER SKINS

local function renderSkins()

    clearList()

    local query = string.lower(SearchBox.Text)

    local visibleCount = 0

    for _, skinData in ipairs(FoundSkins) do

        local searchText = string.lower(
            skinData.Name
            .. " "
            .. skinData.Character
            .. " "
            .. skinData.Category
        )

        local matches = query == ""
            or string.find(
                searchText,
                query,
                1,
                true
            ) ~= nil

        if matches then

            visibleCount += 1

            createSkinEntry(
                skinData,
                visibleCount
            )

        end

    end

    Counter.Text = string.format(
        "Skins found: %d | Showing: %d",
        #FoundSkins,
        visibleCount
    )

    if visibleCount == 0 then

        local EmptyLabel = create("TextLabel", {
            Name = "Empty",

            Size = UDim2.new(1, -10, 0, 60),

            BackgroundTransparency = 1,

            Text = "No skins found",

            Font = Enum.Font.Gotham,
            TextSize = 14,

            TextColor3 = CONFIG.MutedText,

            LayoutOrder = 1
        }, Scroll)

    end

end

--// REFRESH

local refreshing = false

local function refreshSkins()

    if refreshing then
        return
    end

    refreshing = true

    RefreshButton.Text = "Scanning..."

    task.spawn(function()

        local success, err = pcall(function()

            scanSkins()
            renderSkins()

        end)

        refreshing = false

        if not RefreshButton.Parent then
            return
        end

        RefreshButton.Text = "Refresh"

        if success then

            notify(
                "Found " .. tostring(#FoundSkins) .. " skins",
                CONFIG.Success
            )

        else

            warn("[Refresh Error] " .. tostring(err))

            notify("Skin scan failed", CONFIG.Error)

        end

    end)

end

